NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aws_club_management
FRONTEND_URL=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=your_strong_random_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=aws-club-management
JWT_AUDIENCE=aws-club-app

# Refresh Token
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Security
SALT_ROUNDS=12

# Student ID
STUDENT_ID_PREFIX=AWS
